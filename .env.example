# Django
SECRET_KEY=
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database (postgres:16 service in docker-compose)
DATABASE_URL=postgres://hshield:hshield@db:5432/hshield237
POSTGRES_DB=hshield237
POSTGRES_USER=hshield
POSTGRES_PASSWORD=

# Anthropic / Claude API
# Cle a generer sur console.anthropic.com (independante de l'abonnement
# Claude Pro utilise pour Claude Code). Peut rester vide : le mode manuel
# (POST /api/generation/manuel/) fonctionne sans elle.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Identifiant exact du modele a verifier sur console.anthropic.com
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# Email (SMTP) — utiliser un compte de test (Mailtrap ou equivalent) en dev,
# jamais un serveur SMTP auto-heberge, jamais de vrais emails hors production.
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=no-reply@example.com
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True

# Simulation d'envoi (apps.simulation)
# URL publique de base utilisee pour construire les liens de la fausse page
# de capture inseres dans les emails simules.
SIMULATION_BASE_URL=https://localhost

# Frontend
VITE_API_BASE_URL=/api
